# ==========================================================================
# QQ 机器人环境变量模板
# ==========================================================================
# 复制成 .env 再填。**这个文件本身不含任何真实凭据，可以入库。**
#
#   cp .env.example .env && chmod 600 .env
#
# 优先级：config.toml  <  data/settings.json  <  .env
# 也就是说 .env 里的值最优先 —— 密钥只放这里，不放 settings.json。
# ==========================================================================

# ---- NapCat / OneBot ----
# NapCat 反向/正向 WS 的 token，空表示不校验
ONEBOT_TOKEN=
# 正向 WebSocket 地址
ONEBOT_WS_URL=ws://127.0.0.1:3001

# ---- 管理面板 ----
# 面板登录令牌。**务必改掉，并且别用弱口令** —— 面板能改配置、删记忆。
# 留空则不校验（只适合本机调试）
WEB_TOKEN=
# 面板监听地址（默认见 config.toml；127.0.0.1 最安全）
WEB_HOST=
# 面板监听端口
QQBOT_WEB_PORT=8090

# ---- 数据库 ----
QQBOT_DB_PATH=data/qqbot.db

# ---- 日志 ----
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ==========================================================================
# LLM（OpenAI 兼容接口）
# ==========================================================================
# 任何 OpenAI 兼容端点都行：官方 API、vLLM、one-api、cli-proxy 等
LLM_API_KEY=

# ==========================================================================
# PaddleOCR-VL（可选）
# ==========================================================================
# https://paddleocr.aistudio-app.com —— 申请后填这里
# 不填则只用 NapCat 自带的快速 OCR
PADDLEOCR_TOKEN=

# ==========================================================================
# 网络搜索（可选）
# ==========================================================================
# 支持 tavily / bocha（博查）/ serper / searxng（自建）/ ollama
SEARCH_API_KEY=

# ==========================================================================
# B 站（可选，但 AI 字幕必需）
# ==========================================================================
# AI 字幕**必须登录态**才下发；游客态一律拿不到，buvid 也不行。
# 面板「设置 → B站视频 → 扫码登录」会自动写入下面三项，不用手填。
#
# 完整 Cookie 串，至少含 SESSDATA=xxx
# 例：SESSDATA=abc%2C1234567890%2Cdef; bili_jct=xxx; DedeUserID=12345
BILIBILI_COOKIE=
# 游客指纹（没有登录 Cookie 时，搜索至少需要 buvid3，否则 412 风控）
BILIBILI_BUVID3=
BILIBILI_BUVID4=

# ==========================================================================
# StepFun 音频转写（可选）
# ==========================================================================
# 用于 B 站无字幕视频的兜底转写。
# 注意：step_plan 免费套餐**不含 ASR**（音频路径全是 404），必须走 /v1 且账户有余额。
STEPFUN_API_KEY=

# ==========================================================================
# 远端仓库同步（tools/sync.py 用）
# ==========================================================================
# 如果你使用 CNB 同步，令牌权限只需 **git 读写** —— 不要用顶级权限的令牌。
# 在对应代码托管平台的「访问令牌」页面创建，然后填这里。
#
#   ./.venv/bin/python -m tools.sync -m "fix: 修了 xxx"
CNB_TOKEN=